// =========================================================
// SCHEMA PRISMA - Urpi Wayra Adventures
// Generado a partir de los catálogos: Camino Inca + Cusco/Valle Sagrado
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")   // ← esto es nuevo, agrégalo a tu .env también
}

// ---------------------------------------------------------
// TOUR: la entidad principal (ej: "Camino Inca Clásico 4D",
// "City Tour Cusco", "Valle Sagrado VIP")
// ---------------------------------------------------------
model Tour {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  category       String   // "Camino Inca" | "Cusco & Valle Sagrado" | "Treks Alternativos" | etc.

  // Descripción general / marketing
  shortDescription String? @db.Text  // ej: "Explora la magia de la capital inca..."
  description      String? @db.Text

  // Specs del trekking/tour (aplica sobre todo a Camino Inca)
  durationDays     Int
  durationNights   Int?
  difficulty       String?   // "Moderada a Desafiante", "Fácil", etc.
  maxAltitudeM     Int?      // altitud máxima en msnm
  minGroupSize     Int?      // ej: 2
  maxGroupSize     Int?      // ej: 12
  guideLanguages   String?   // "Inglés y Español"

  // Lugares que visita (para tours tipo City Tour / Valle Sagrado)
  placesVisited    String?   @db.Text // lista separada por comas o JSON

  published        Boolean  @default(false)
  featured         Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  itinerary        TourItinerary[]
  options          TourOption[]
  inclusions       TourInclusion[]
  reservas         Reserva[]

  @@index([category])
  @@index([published])
}

// ---------------------------------------------------------
// TOUR ITINERARY: día a día (solo aplica a tours multi-día
// como Camino Inca; los tours de 1 día pueden omitir esto)
// ---------------------------------------------------------
model TourItinerary {
  id                 String  @id @default(cuid())
  tourId             String
  tour               Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  dayNumber          Int
  title              String  // "El Reto Mayor – Conquistando el Paso de la Mujer Muerta"
  route              String? // "Wayllabamba → Warmiwañusqa → Pacaymayo"
  description        String  @db.Text

  distanceKm         Float?
  durationText       String? // "6-7 horas" (texto libre, más flexible que un número)
  altitudeM          Int?    // altitud del campamento/parada de ese día

  accommodationType  String? // "Campamento" | "Hotel"
  accommodationName  String? // "Wiñay Wayna (2,680 m)"

  createdAt          DateTime @default(now())

  @@unique([tourId, dayNumber])
}

// ---------------------------------------------------------
// TOUR OPTION: modalidad y precio (Grupal / Privada)
// Un tour puede tener 1 o varias opciones
// ---------------------------------------------------------
model TourOption {
  id               String   @id @default(cuid())
  tourId           String
  tour             Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  modality         String   // "Grupal" | "Privada"
  pricePerPerson   Decimal? @db.Decimal(10, 2) // null = "Contact for pricing"
  currency         String   @default("USD")
  minPeople        Int?     @default(1)        // ej: mínimo 2 para privado
  maxPeople        Int?

  active           Boolean  @default(true)

  reservas         Reserva[]

  @@unique([tourId, modality])
}

// ---------------------------------------------------------
// TOUR INCLUSION: qué incluye / qué no incluye
// (un solo modelo con un campo "type" para no duplicar tablas)
// ---------------------------------------------------------
model TourInclusion {
  id       String @id @default(cuid())
  tourId   String
  tour     Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  type     InclusionType // INCLUYE | NO_INCLUYE
  item     String        @db.Text
  order    Int           @default(0)

  @@index([tourId, type])
}

enum InclusionType {
  INCLUYE
  NO_INCLUYE
}

// ---------------------------------------------------------
// RESERVA: la reserva que hace un cliente
// ---------------------------------------------------------
model Reserva {
  id             String   @id @default(cuid())
  tourId         String
  tour           Tour     @relation(fields: [tourId], references: [id])
  tourOptionId   String
  tourOption     TourOption @relation(fields: [tourOptionId], references: [id])

  clienteNombre  String
  clienteEmail   String
  clienteTelefono String?

  numPersonas    Int
  fechaViaje     DateTime
  montoTotal     Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")

  estado         ReservaEstado @default(PENDIENTE)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pago           Pago?

  @@index([tourId])
  @@index([estado])
}

enum ReservaEstado {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

// ---------------------------------------------------------
// PAGO: registro del pago vía Mercado Pago Checkout Pro
// ---------------------------------------------------------
model Pago {
  id                String   @id @default(cuid())
  reservaId         String   @unique
  reserva           Reserva  @relation(fields: [reservaId], references: [id])

  mercadoPagoId     String   @unique // payment_id que devuelve MP
  preferenceId      String?
  status            String   // "approved" | "pending" | "rejected", etc. (viene de MP)
  statusDetail      String?
  monto             Decimal  @db.Decimal(10, 2)
  currency          String   @default("USD")

  webhookVerified   Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
