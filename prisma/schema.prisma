generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  description  String
  duration     String
  difficulty   String
  maxAltitude  Int?
  maxGroupSize Int?
  languages    String
  category     String   // <-- NUEVO: "camino-inca" | "cusco-valle-sagrado" | "treks-alternativos"
  price        Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prices       TourPrice[]
  itineraries  TourItinerary[]
  includes     TourInclude[]
  excludes     TourExclude[]
  images       TourImage[]
}


model TourPrice {
  id        Int    @id @default(autoincrement())
  tourId    Int
  type      String
  price     Float
  minPeople Int?

  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourItinerary {
  id             Int    @id @default(autoincrement())
  tourId        Int
  day            Int
  title          String
  description    String
  distance       String?
  hikingTime     String?
  accommodation String?

  tour           Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, day])
}

model TourInclude {
  id      Int    @id @default(autoincrement())
  tourId  Int
  item    String

  tour    Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourExclude {
  id      Int    @id @default(autoincrement())
  tourId  Int
  item    String

  tour    Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourImage {
  id      Int    @id @default(autoincrement())
  tourId  Int
  url     String
  alt     String?

  tour    Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}